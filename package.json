{
  "name": "hono-verified-permissions",
  "version": "0.1.0",
  "description": "Cedar authorization middleware for Hono with Amazon Verified Permissions support",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "examples"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run build && tsc -p tsconfig.check.json",
    "test": "npm run build && node --test test/middleware.test.ts",
    "test:emulator": "npm run build && node scripts/test-emulator.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "hono": "^4.13.0"
  },
  "dependencies": {
    "@cedar-policy/cedar-authorization": "^0.2.0",
    "openapi-types": "^12.1.3"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1172.0",
    "@aws-sdk/client-verifiedpermissions": "^3.1172.0",
    "@types/node": "^24.19.2",
    "@verifiedpermissions/authorization-clients-js": "^0.2.0",
    "hono": "^4.13.19",
    "typescript": "~6.0.3"
  }
}
